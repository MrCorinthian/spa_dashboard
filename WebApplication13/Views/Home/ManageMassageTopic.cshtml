@model WebApplication13.Models.HeaderForMaster
<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="">
    <meta name="author" content="">

    <title>Spa System Admin Panel</title>

    <!-- Bootstrap Core CSS -->
    <link href="../vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">

    <!-- MetisMenu CSS -->
    <link href="../vendor/metisMenu/metisMenu.min.css" rel="stylesheet">

    <!-- Custom CSS -->
    <link href="../dist/css/sb-admin-2.css" rel="stylesheet">

    <!-- Morris Charts CSS -->
    <link href="../vendor/morrisjs/morris.css" rel="stylesheet">

    <!-- Custom Fonts -->
    <link href="../vendor/font-awesome/css/font-awesome.min.css" rel="stylesheet" type="text/css">

    <!-- HTML5 Shim and Respond.js IE8 support of HTML5 elements and media queries -->
    <!-- WARNING: Respond.js doesn't work if you view the page via file:// -->
    <!--[if lt IE 9]>
        <script src="https://oss.maxcdn.com/libs/html5shiv/3.7.0/html5shiv.js"></script>
        <script src="https://oss.maxcdn.com/libs/respond.js/1.4.2/respond.min.js"></script>
    <![endif]-->
    <link href="../Content/progressring1.css" rel="stylesheet">

    <script type="text/javascript">
        function toggleOverlay() {
            var overlay = document.getElementById("overlay");
            overlay.style.display = "block";
            overlay.style.pointerEvents = "none";
        }
    </script>
    <script type="text/javascript">
        function hideOverlay() {
            var overlay = document.getElementById("overlay");
            overlay.style.display = "none";
            overlay.style.pointerEvents = "auto";
        }
    </script>
    <script type="text/javascript">
        function navigateToOtherPage() {
            document.getElementById("overlay").style.display = "block";
        }
    </script>

    <script type="text/javascript">

        function navigationSuccess() {
            document.getElementById("overlay").style.display = "none";
        }

    </script>

</head>

<body>
    <div id="wrapper">
        <div id="overlay">
            <div class="spinner">
                <div class="ring"></div>
            </div>
        </div>

        <!-- Navigation -->
        <nav class="navbar navbar-default navbar-static-top" role="navigation" style="margin-bottom: 0">
            <div class="navbar-header">
                <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse">
                    <span class="sr-only">Toggle navigation</span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>
                <a class="navbar-brand" href="#">Spa System Admin Panel</a>
            </div>
            <!-- /.navbar-header -->

            <ul class="nav navbar-top-links navbar-right">
                &nbsp;&nbsp;
                <b>@Html.DisplayFor(model => model.strLoginName)</b> &nbsp;&nbsp;
                <li class="dropdown">
                    <a href="@Url.Action("Urban", "Home",new { cmd = "logout" })"><i class="fa fa-power-off fa-2x"></i></a>
                </li>
                <!-- /.dropdown -->
            </ul>
            <!-- /.navbar-top-links -->

            <div class="navbar-default sidebar" role="navigation">
                <div class="sidebar-nav navbar-collapse">
                    <ul class="nav" id="side-menu">
                        <li>
                            <a href="@Url.Action("Dashboard", "Home")" onclick="navigateToOtherPage();">@*<i class="fa fa-chevron-down fa-fw"></i>*@ &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Dashboard</a>
                        </li>
                    </ul>
                </div>
                <!-- /.sidebar-collapse -->
            </div>
            <!-- /.navbar-static-side -->
        </nav>

        <!-- Page Content -->
        <div id="page-wrapper">
            <div class="container-fluid">
                <div class="row">
                    <div class="col-lg-12">
                        <h1 class="page-header">Massage Topic Management</h1>

                        <!-- Create/Back Button -->
                        <button id="createBtn" class="btn btn-success create">Create New Massage Topic</button>


                        <!-- Content Zone where the partials will load -->
                        <div id="content-zone">
                            @Html.Partial("_MassageTopicListPartial", Model.MassageTopics)
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- /#page-wrapper -->

    </div>
    <!-- /#wrapper -->
    <!-- jQuery -->
    <script src="../vendor/jquery/jquery.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- Bootstrap Core JavaScript -->
    <script src="../vendor/bootstrap/js/bootstrap.min.js"></script>

    <!-- Metis Menu Plugin JavaScript -->
    <script src="../vendor/metisMenu/metisMenu.min.js"></script>

    <!-- Custom Theme JavaScript -->
    <script src="../dist/js/sb-admin-2.js"></script>

    <!-- DataTables JavaScript -->
    <script src="../vendor/datatables/js/jquery.dataTables.min.js"></script>
    <script src="../vendor/datatables-plugins/dataTables.bootstrap.min.js"></script>
    <script src="../vendor/datatables-responsive/dataTables.responsive.js"></script>


    <script>
    $(document).ready(function () {
    console.log("Document is ready");

    // Log the resolved URL for debugging
    console.log('@Url.Action("LoadCreateForm", "Home")');

    // Load Create Form on button click
    $('#createBtn').on('click', function () {
        console.log("Create button clicked");

        // Check if the button is "Create" or "Back"
        if ($(this).hasClass('create')) {
            console.log("Loading create form");

            // Load create form via AJAX
            $.ajax({
                url: '@Url.Action("LoadCreateForm", "Home")',
                type: 'GET',
                success: function (data) {
                    console.log("AJAX success, form loaded");
                    $('#content-zone').html(data);
                    $('#createBtn').removeClass('create').addClass('back').text('Back');
                },
                error: function (xhr, status, error) {
                    console.log("AJAX error:", error);
                    alert("Error loading create form");
                }
            });
        } else if ($(this).hasClass('back')) {
            console.log("Loading topic list");

            // Load the original list (table) back via AJAX
            $.ajax({
                url: '@Url.Action("ReloadMassageTopicList", "Home")',
                type: 'GET',
                success: function (data) {
                    console.log("AJAX success, list reloaded");
                    $('#content-zone').html(data);
                    $('#createBtn').removeClass('back').addClass('create').text('Create New Massage Topic');
                },
                error: function (xhr, status, error) {
                    console.log("AJAX error:", error);
                    alert("Error loading topic list");
                }
            });
        }
    });

    // Handle form submission via AJAX
    $(document).on('submit', '#createForm', function (e) {
        e.preventDefault();

        $.ajax({
            url: $(this).attr('action'),
            type: 'POST',
            data: $(this).serialize(),
            success: function (data) {
                $('#content-zone').html(data);
                $('#createBtn').removeClass('back').addClass('create').text('Create New Massage Topic');
            },
            error: function () {
                alert("Error creating massage topic");
            }
        });
    });
});

    </script>


</body>

</html>
